generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────── Enums ─────────

enum UserRole {
  ADMIN
  QA_ENGINEER
  DEVELOPER
  VIEWER
}

enum Platform {
  WEB
  API
  MOBILE
}

enum RequirementType {
  DOCUMENT
  URL
  CODE
  API_SPEC
}

enum IndexStatus {
  PENDING
  INDEXING
  READY
  FAILED
}

enum TestType {
  FUNCTIONAL
  BOUNDARY
  NEGATIVE
  SECURITY
  API
  MOBILE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum RunStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum ResultStatus {
  PASSED
  FAILED
  SKIPPED
  ERROR
}

enum Severity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum BugStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
  DUPLICATE
}

enum IntegrationType {
  SLACK
  JIRA
  EMAIL
}

enum ChatRole {
  USER
  ASSISTANT
}

// ───────── Models ─────────

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(QA_ENGINEER)
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ownedProjects Project[]       @relation("ProjectOwner")
  memberships   ProjectMember[]
  triggeredRuns TestRun[]
  reportedBugs  Bug[]           @relation("BugReporter")
  assignedBugs  Bug[]           @relation("BugAssignee")
  comments      Comment[]
  notifications Notification[]
  chatMessages  ChatMessage[]
}

model Project {
  id          String   @id @default(uuid())
  name        String
  description String?
  baseUrl     String?
  platform    Platform @default(WEB)
  ownerId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner        User            @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members      ProjectMember[]
  requirements Requirement[]
  testCases    TestCase[]
  runs         TestRun[]
  bugs         Bug[]
  reports      Report[]
  integrations Integration[]
  chatMessages ChatMessage[]

  @@index([ownerId])
}

model ProjectMember {
  id        String   @id @default(uuid())
  projectId String
  userId    String
  role      UserRole @default(QA_ENGINEER)
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
}

model Requirement {
  id         String          @id @default(uuid())
  projectId  String
  title      String
  type       RequirementType
  sourceUrl  String?
  filePath   String?
  status     IndexStatus     @default(PENDING)
  chunkCount Int             @default(0)
  errorMsg   String?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  testCases TestCase[]

  @@index([projectId])
}

model TestCase {
  id             String    @id @default(uuid())
  projectId      String
  requirementId  String?
  title          String
  description    String?
  module         String?
  type           TestType  @default(FUNCTIONAL)
  platform       Platform  @default(WEB)
  priority       Priority  @default(MEDIUM)
  preconditions  String?
  steps          Json      @default("[]")
  expectedResult String?
  testData       Json?
  generatedByAI  Boolean   @default(true)
  priorityScore  Float?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requirement Requirement? @relation(fields: [requirementId], references: [id], onDelete: SetNull)
  results     TestResult[]

  @@index([projectId])
  @@index([projectId, module])
}

model TestRun {
  id            String    @id @default(uuid())
  runCode       String    @unique
  projectId     String
  triggeredById String
  status        RunStatus @default(QUEUED)
  stage         String    @default("requirements_analysis")
  progress      Int       @default(0)
  targetUrl     String?
  total         Int       @default(0)
  passed        Int       @default(0)
  failed        Int       @default(0)
  skipped       Int       @default(0)
  coverage      Float?
  deployRisk    Float?
  startedAt     DateTime?
  finishedAt    DateTime?
  errorMsg      String?
  createdAt     DateTime  @default(now())

  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  triggeredBy User         @relation(fields: [triggeredById], references: [id])
  results     TestResult[]
  bugs        Bug[]
  reports     Report[]

  @@index([projectId, createdAt])
}

model TestResult {
  id             String       @id @default(uuid())
  runId          String
  testCaseId     String
  status         ResultStatus
  durationMs     Int          @default(0)
  errorMessage   String?
  logs           String?
  screenshotPath String?
  response       Json?
  createdAt      DateTime     @default(now())

  run      TestRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  testCase TestCase @relation(fields: [testCaseId], references: [id], onDelete: Cascade)
  bug      Bug?

  @@index([runId])
  @@index([testCaseId])
}

model Bug {
  id               String    @id @default(uuid())
  number           Int       @unique @default(autoincrement())
  projectId        String
  runId            String?
  testResultId     String?   @unique
  title            String
  description      String?
  module           String?
  aiExplanation    String?
  recommendedFix   String?
  fixPatch         String?
  confidence       Float?
  severity         Severity  @default(MEDIUM)
  severityScore    Float?
  status           BugStatus @default(OPEN)
  reporterId       String?
  assigneeId       String?
  duplicateOfId    String?
  duplicateScore   Float?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  run         TestRun?    @relation(fields: [runId], references: [id], onDelete: SetNull)
  testResult  TestResult? @relation(fields: [testResultId], references: [id], onDelete: SetNull)
  reporter    User?       @relation("BugReporter", fields: [reporterId], references: [id], onDelete: SetNull)
  assignee    User?       @relation("BugAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  duplicateOf Bug?        @relation("BugDuplicates", fields: [duplicateOfId], references: [id], onDelete: SetNull)
  duplicates  Bug[]       @relation("BugDuplicates")
  comments    Comment[]

  @@index([projectId, status])
  @@index([projectId, severity])
}

model Comment {
  id        String   @id @default(uuid())
  bugId     String
  authorId  String
  body      String
  createdAt DateTime @default(now())

  bug    Bug  @relation(fields: [bugId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([bugId])
}

model Report {
  id        String   @id @default(uuid())
  projectId String
  runId     String?
  title     String
  summary   String?
  filePath  String?
  createdAt DateTime @default(now())

  project Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  run     TestRun? @relation(fields: [runId], references: [id], onDelete: SetNull)

  @@index([projectId])
}

model Integration {
  id        String          @id @default(uuid())
  projectId String
  type      IntegrationType
  config    Json            @default("{}")
  enabled   Boolean         @default(true)
  createdAt DateTime        @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, type])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String?
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
}

model ChatMessage {
  id        String   @id @default(uuid())
  userId    String
  projectId String?
  role      ChatRole
  content   String
  createdAt DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([userId, projectId])
}
